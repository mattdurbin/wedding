{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedding-photo-upload",
  "main": "worker.js",
  "compatibility_date": "2026-03-30",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "wedding.durbin.uk/api/*",
      "zone_name": "durbin.uk"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEDDING_UPLOADS",
      "bucket_name": "wedding-uploads"
    }
  ],
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "ADMIN_PASSWORD",
      "ADMIN_SESSION_SECRET"
    ]
  }
}